(version 1)
# TokenKey RT custom design rules (ACTIVE: renamed from .kicad_dru.staged when
# TokenKey-RT.kicad_pcb was created).
# Target fab: JLCPCB 4-layer 1.6 mm, impedance stackup JLC04161H-3313, ENIG.
# See docs/layout-notes.md for values, sources and the open DFM caveat.
# MCU reference designator is U1 (checked against the imported netlist).
# Board Setup > Constraints must hold the global floors listed in
# docs/layout-notes.md (min track 0.10, min clearance 0.10, min annular 0.075,
# min via 0.30/0.15, min through-hole 0.15, hole-to-hole 0.25, copper-to-edge 0.30,
# hole clearance 0.20); the rules below then tighten or relax per area.

# ---------- Outside the BGA: hold the standard (no-surcharge) values ----------
(rule "Default clearance outside BGA"
  (condition "!A.intersectsCourtyard('U1') && !B.intersectsCourtyard('U1')")
  (constraint clearance (min 0.15mm)))

(rule "Default track width outside BGA"
  (condition "A.Type == 'track' && !A.intersectsCourtyard('U1')")
  (constraint track_width (min 0.15mm)))

(rule "Via annular ring outside BGA"
  (condition "A.Type == 'via' && !A.intersectsCourtyard('U1')")
  (constraint annular_width (min 0.125mm)))

(rule "Via size outside BGA"
  (condition "A.Type == 'via' && !A.intersectsCourtyard('U1')")
  (constraint hole_size (min 0.30mm))
  (constraint via_diameter (min 0.60mm)))

# JLC "Via hole to Track 0.2 mm" applies everywhere, BGA fan-out included
# (confirmed by TokenKey DFM). No exception anywhere.
(rule "Via hole to track (JLC 0.2 mm)"
  (constraint hole_clearance (min 0.20mm)))

# ---------- Inside the MCU courtyard: 0.65 mm-pitch MAPBGA196 fan-out ----------
# LOCKED (PM 2026-10-19): BGA via 0.15 mm drill / 0.30 mm pad (0.075 mm ring).
# 0.65 mm pitch, centred 0.10 mm track: hole-to-track 0.200 mm, pad-to-track
# 0.125 mm, one track per channel. JLC small-via surcharge (0.15 mm hole);
# aspect ratio 10.7:1 at 1.6 mm, to be confirmed by DFM.
# Set BGA vias TENTED on both sides (via properties); DRC does not check this.
# Via covering (mask vs plugged/epoxy) is open with DFM; see layout-notes 4.2.
(rule "BGA escape track/space"
  (condition "A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1')")
  (constraint track_width (min 0.10mm) (opt 0.10mm))
  (constraint clearance (min 0.10mm)))

(rule "BGA via"
  (condition "A.Type == 'via' && A.intersectsCourtyard('U1')")
  (constraint hole_size (min 0.15mm))
  (constraint via_diameter (min 0.30mm))
  (constraint annular_width (min 0.075mm)))

# ---------- Net classes ----------
(rule "USB 90R differential pair"
  (condition "A.hasNetclass('USB_HS')")
  (constraint track_width (min 0.145mm) (opt 0.155mm) (max 0.20mm))
  (constraint diff_pair_gap (min 0.18mm) (opt 0.20mm) (max 2.0mm))
  (constraint diff_pair_uncoupled (max 12mm))
  (constraint skew (max 0.15mm))
  (constraint via_count (max 2)))
# PM-approved exception (#58): the BGA channels (1.3 mm apart) and the USBLC6
# flow-through pins (1.9 mm apart) prevent a coupled 0.20 mm gap, so the pair
# runs mostly uncoupled: gap max relaxed to 2.0 mm, uncoupled max 12 mm.
# Uncoupled L1 sections use 0.185 mm (~45 ohm single-ended over In1 GND,
# JLC04161H-3313; see layout-notes 5). Two vias per net are the J1 B-row
# via-in-pad ties (A6-B6 DP, B7-A7 DN on B.Cu).

# J1 B-row via-in-pad (PM-approved, #58): 0.15/0.30 mm via inside the 0.3 mm
# J1 pads, filled and capped (order note). Exempt from the 0.5 mm USB
# keep-away against the neighbouring J1 pads (pad-pitch-limited, like the
# pad-to-pad exclusion); default 0.15 mm clearance still applies.
(rule "J1 USB via-in-pad"
  (condition "A.Type == 'via' && A.hasNetclass('USB_HS')")
  (constraint hole_size (min 0.15mm))
  (constraint via_diameter (min 0.30mm))
  (constraint annular_width (min 0.075mm)))

(rule "USB neck-down inside BGA"
  (layer outer)
  (condition "A.hasNetclass('USB_HS') && A.intersectsCourtyard('U1')")
  (constraint track_width (min 0.10mm) (opt 0.10mm)))

# Pad-to-pad pairs are excluded: the USB-C (0.5 mm pitch) and USBLC6 pins are
# fixed by the footprints; the 0.5 mm keep-away is for routed copper.
(rule "USB keep-away from other signals"
  (condition "A.hasNetclass('USB_HS') && !B.hasNetclass('USB_HS') && !(A.Type == 'pad' && B.Type == 'pad') && !(A.Type == 'via' && B.Type == 'pad') && !A.intersectsCourtyard('U1') && !B.intersectsCourtyard('U1')")
  (constraint clearance (min 0.50mm)))

# Power (PM-approved): 0.40 mm for 3V3/VBUS trunks (net class width),
# 0.30 mm minimum allowed for local branches.
(rule "Power track width"
  (condition "A.hasNetclass('Power') && !A.intersectsCourtyard('U1')")
  (constraint track_width (min 0.30mm) (opt 0.40mm)))

# ---------- Mechanical ----------
(rule "Copper to board edge"
  (constraint edge_clearance (min 0.30mm)))

(rule "Hole to hole"
  (constraint hole_to_hole (min 0.25mm)))

(rule "PTH pad hole-to-hole (JLC 0.45 mm)"
  (condition "A.Type == 'pad' && B.Type == 'pad' && A.isPlated() && B.isPlated()")
  (constraint hole_to_hole (min 0.45mm)))

(rule "PTH pad hole to copper (JLC 0.28 outer / 0.3 inner)"
  (condition "A.Type == 'pad' && A.isPlated() && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.30mm)))

# Mounting holes: 5.0 mm-diameter keepout on all layers is drawn in the
# MountingHole_2.2mm_M2 footprints / rule areas; NPTH-to-track >= 0.2 mm (JLC).
(rule "NPTH to copper"
  (condition "A.Type == 'pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.20mm)))

# M2 holes H1-H4: 5.0 mm keepout (r = 2.5 mm) for copper on every layer.
# 2.2 mm hole, so hole edge to copper >= 1.4 mm. Footprint keepout comes from
# the MountingHole_2.2mm_M2 courtyard (r = 2.45 mm, F side); bottom-side parts
# were placed outside r = 2.5 mm by hand.
(rule "M2 mounting-hole copper keepout"
  (condition "A.memberOfFootprint('H*')")
  (constraint hole_clearance (min 1.4mm)))

# ---------- Keep-under-OLED (NOT machine-checked) ----------
# KiCad has no component-height DRC. Inside the OLED module outline
# (HS96L03W2C03 module PCB 27.30 x 27.80 mm at x 6.50-33.80, y 3.56-31.36 (J2 at y 5.0),
# rule area OLED_KEEP_UNDER; docs/layout-notes.md section 10.1), top-side parts
# must be <= 2.0 mm tall (PM, tightened from 2.5 mm). Check by hand using the
# 3D models / BOM heights.
